{
  "name": "places-again",
  "options": {
    "allow-unauthenticated": true,
    "memory": "512Mi",
    "cpu": "1",
    "port": 8080,
    "concurrency": 1,
    "max-instances": 1
  },
  "hooks": {
    "prebuild": {
      "commands": [
        "bash scripts/cloud_run_button_prebuild.sh"
      ]
    },
    "postcreate": {
      "commands": [
        "bash scripts/cloud_run_button_postcreate.sh"
      ]
    }
  }
}
